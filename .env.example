# BOSS local desk
PORT=8790
BOSS_DATA_DIR=./var

# Public Binance Spot REST (read-only market data). Do not point this at a proxy that invents prices.
BINANCE_SPOT_BASE=https://api.binance.com

# HMAC secret for stamped clientOrderId values (32+ chars). If unset, BOSS writes var/hmac.secret.
# BOSS_HMAC_SECRET=

# Set to 1 only if you must boot without a public Binance feed.
# BOSS_ALLOW_OFFLINE=0

# Optional: signed Spot orders from this desk after a valid EXECUTE approval.
# Leave unset to keep execution exclusive to Binance Agent OS MCP in your AI host.
# BINANCE_API_KEY=
# BINANCE_SECRET_KEY=
# BINANCE_API_ENV=mainnet

# Sentiment in analysis uses free public feeds (Fear & Greed, Google News RSS, CoinGecko, Reddit).
# No third-party API key required.
