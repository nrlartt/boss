# BOSS local desk — copy to .env (never commit .env)

# HTTP port (Railway sets PORT automatically)
PORT=8790

# Persistent state: mandate, session, receipts, HMAC file
BOSS_DATA_DIR=./var

# Public Binance Spot REST. Cloud deploys default to data-api.binance.vision.
BINANCE_SPOT_BASE=https://api.binance.com

# Order stamp secret (32+ chars). If unset, BOSS writes var/hmac.secret on first run.
# BOSS_HMAC_SECRET=

# Boot without a reachable public feed (not recommended for production)
# BOSS_ALLOW_OFFLINE=0

# Public URL for MCP links when behind a reverse proxy
# BOSS_PUBLIC_URL=https://your-host.example.com

# Force hosted UI mode
# BOSS_HOSTED=1

# Extra symbols on the tape (comma-separated, e.g. WLDUSDT,ARBUSDT)
# BOSS_WATCH_SYMBOLS=

# Optional: send approved orders from this machine (leave unset to use Agent OS only)
# BINANCE_API_KEY=
# BINANCE_SECRET_KEY=
# BINANCE_API_ENV=mainnet
